# Sensus Backend — plantilla de variables de entorno
#
# Copiar a `.env` para desarrollo local y completar los valores.
# `.env` NO se versiona. En AWS los valores provienen de Secrets Manager / SSM (constitution.md P-IV).
# Nunca escribir valores reales en este archivo ni en `appsettings.json`.

# --- Entorno ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# --- MongoDB ---------------------------------------------------------------
# En local coincide con docker-compose.yml. En producción, cadena de Secrets Manager.
MONGO_CONNECTION_STRING=mongodb://sensus:sensus-local-only@localhost:27017/?authSource=admin
MONGO_DATABASE=sensus

# --- JWT -------------------------------------------------------------------
# Generar con: openssl rand -base64 64
# El valor versionado en appsettings.json está comprometido y debe rotarse (specs 001 y 002).
JWT__SECRET=
JWT__ISSUER=sensus-api
JWT__AUDIENCE=sensus-clients
JWT__EXPIRATION_MINUTES=60

# --- Moderación (OpenAI omni-moderation-latest) ----------------------------
# Clave gestionada en Secrets Manager. Nunca en el repositorio.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_TIMEOUT_SECONDS=10

# --- Umbrales de moderación (spec 018) -------------------------------------
MODERATION__BAND_LOW_MAX=0.30
MODERATION__BAND_MEDIUM_MAX=0.70

# --- CORS (spec 012) -------------------------------------------------------
# Lista separada por comas. Prohibido `*` fuera de Development.
CORS__ALLOWED_ORIGINS=https://localhost:3000

# --- Rate limiting (spec 013) ---------------------------------------------
RATE_LIMIT__PERMIT_LIMIT=60
RATE_LIMIT__WINDOW_SECONDS=60
RATE_LIMIT__AUTH_PERMIT_LIMIT=5

# --- Almacenamiento multimedia (specs 022 y 023) ---------------------------
AWS__REGION=us-east-1
AWS__S3_BUCKET=sensus-media-dev
AWS__CLOUDFRONT_DOMAIN=
AWS__PRESIGNED_URL_TTL_SECONDS=300

# --- Observabilidad (spec 014) --------------------------------------------
LOG_LEVEL__DEFAULT=Information
LOG_LEVEL__MICROSOFT_ASPNETCORE=Warning
